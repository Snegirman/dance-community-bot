# Copy to .env. Telegram credentials and webhook settings are used for now.
# Never commit real tokens or keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_URL=
# Generate locally, for example: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Local HTTP port behind an HTTPS proxy or tunnel; listens on 127.0.0.1.
WEBHOOK_PORT=8080

# SQLite path; originals belong in posters/ beside the database.
# Connecting storage to Telegram handlers is the next implementation stage.
DATABASE_PATH=data/dance-community-bot.sqlite3

# Reserved for later stages.
TELEGRAM_GROUP_ID=

TIMEZONE=Europe/Moscow
# Monday publication time, local HH:MM. Not chosen; leave empty for now.
WEEKLY_PUBLICATION_TIME=
