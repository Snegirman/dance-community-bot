# Copy to .env. Telegram credentials and webhook settings are required.
# Never commit real tokens or keys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_URL=
# Generate locally, for example: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Local HTTP port behind an HTTPS proxy or tunnel; listens on 127.0.0.1.
WEBHOOK_PORT=8080

# SQLite path; originals belong in posters/ beside the database.
DATABASE_PATH=data/dance-community-bot.sqlite3

# Telegram group or supergroup ID; required for manual and automatic publication.
TELEGRAM_GROUP_ID=

# Initial Monday publication time in Europe/Moscow for a new database, HH:MM.
# Change it later with /settings; leave empty to start with automation disabled.
WEEKLY_PUBLICATION_TIME=
